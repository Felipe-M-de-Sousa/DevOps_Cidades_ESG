{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Informacoes do ambiente (/api/ambiente)",
  "type": "object",
  "required": [
    "aplicacao",
    "ambiente",
    "versao"
  ],
  "properties": {
    "aplicacao": {
      "type": "string",
      "minLength": 1
    },
    "ambiente": {
      "type": "string",
      "enum": [
        "local",
        "staging",
        "production"
      ]
    },
    "versao": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    }
  },
  "additionalProperties": false
}